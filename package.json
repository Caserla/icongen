{
  "name": "icongen",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@icongen/web",
    "dev:local": "npm run dev --workspace=@icongen/web -- --local",
    "build:local": "npm run build:local --workspace=@icongen/web",
    "start:local": "npm run start:local --workspace=@icongen/web",
    "build": "npm run build --workspace=@icongen/web",
    "start": "npm run start --workspace=@icongen/web",
    "lint": "npm run lint --workspace=@icongen/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test scripts/*.test.mjs && npm run test --workspaces --if-present",
    "test:security:cost": "node scripts/test-runtime-cost-limits.mjs",
    "test:security:rls": "node scripts/test-cross-account-isolation.mjs",
    "test:security:worker": "node scripts/test-worker-failover.mjs",
    "test:security:staging": "npm run test:security:cost && npm run test:security:rls && npm run test:security:worker",
    "test:e2e:product-gaps": "node --env-file-if-exists=apps/web/.env.local scripts/e2e-product-gap-regression.mjs",
    "test:e2e:browser-compat": "node --env-file-if-exists=apps/web/.env.local scripts/e2e-cross-browser-accessibility.mjs",
    "test:e2e:races-recovery": "node --env-file-if-exists=apps/web/.env.local scripts/e2e-browser-races-and-recovery.mjs",
    "admin:grant": "node --env-file-if-exists=apps/web/.env.local scripts/set-admin-role.mjs grant",
    "admin:revoke": "node --env-file-if-exists=apps/web/.env.local scripts/set-admin-role.mjs revoke",
    "admin:create": "node --env-file-if-exists=apps/web/.env.local scripts/create-admin-account.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "js-yaml": "^4.1.1"
  }
}
