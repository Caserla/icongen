{
  "name": "@icongen/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "build:local": "node scripts/local.mjs build",
    "start:local": "node scripts/local.mjs start",
    "build:turbo": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "find src -name '*.test.ts' -print0 | xargs -0 node --import tsx --test",
    "debug:style-generation": "tsx scripts/test-all-styles-two-icons.ts"
  },
  "dependencies": {
    "@icongen/shared": "*",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "jszip": "^3.10.1",
    "next": "16.4.0",
    "pathkit-wasm": "^1.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "saxes": "^6.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
